Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/PointCloud2
      Name: RS-Helios-5515
      Enabled: true
      Topic:
        Value: __POINTS_TOPIC__
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: false
      Use rainbow: true
      Decay Time: 0
  Global Options:
    Fixed Frame: __FIXED_FRAME__
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Pitch: 0.7
      Yaw: 3.1
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 800
  Width: 1200
