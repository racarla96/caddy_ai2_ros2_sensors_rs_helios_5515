Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: RS-Helios-5515
      Enabled: true
      Topic:
        Value: /caddy_ai2/rs_helios_5515/points
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: false
      Use rainbow: true
      Decay Time: 0
    - Class: rviz_default_plugins/LaserScan
      Name: SICK LMS291
      Enabled: true
      Topic:
        Value: /caddy_ai2/sick_lms_291/scan
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 255; 0
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Pitch: 0.7
      Yaw: 3.1
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 800
  Width: 1200
