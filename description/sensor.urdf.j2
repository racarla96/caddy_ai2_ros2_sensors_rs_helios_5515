{#-
  URDF fragment: link + visual + joint for the RoboSense RS-Helios-5515.
  When gazebo=true, also injects the Gazebo gpu_lidar sensor (publishes PointCloud2).

  Variables always required:
    prefix, sensor_name, frame_id,
    x, y, z, roll, pitch, yaw  (pose relative to base_link),
    sensor_share               (absolute path to this package's share dir)

  Additional variables required only when gazebo=true:
    namespace, channels, horizontal_samples, horizontal_fov,
    vertical_min, vertical_max, range_min, range_max, frequency,
    noise_enabled, noise_mean, noise_stddev
#}

  <link name="{{ prefix }}{{ frame_id }}">
    <inertial>
      <!-- cylinder 100 mm diameter x 100 mm height, ~1 kg; frame at the optical center -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0014583" ixy="0" ixz="0"
               iyy="0.0014583" iyz="0"
               izz="0.00125"/>
    </inertial>
    <visual>
      <!-- Placeholder: no official mesh in the repo yet, so a plain cylinder is used. -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.10"/>
      </geometry>
      <material name="{{ prefix }}{{ sensor_name }}_material">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="{{ prefix }}{{ sensor_name }}_joint" type="fixed">
    <parent link="{{ prefix }}base_link"/>
    <child link="{{ prefix }}{{ frame_id }}"/>
    <origin xyz="{{ x }} {{ y }} {{ z }}" rpy="{{ roll }} {{ pitch }} {{ yaw }}"/>
  </joint>

  <gazebo reference="{{ prefix }}{{ sensor_name }}_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

{%- if gazebo | default(false) %}
{%- set PI = 3.14159265358979 %}
{%- set h_half = horizontal_fov * PI / 360.0 %}
{%- set v_min_rad = vertical_min * PI / 180.0 %}
{%- set v_max_rad = vertical_max * PI / 180.0 %}

  <gazebo reference="{{ prefix }}{{ frame_id }}">
    <sensor name="{{ prefix }}rs_helios_5515" type="gpu_lidar">
      <!-- gpu_lidar publishes LaserScan on <topic> and PointCloudPacked on <topic>/points -->
      <topic>{{ ('/' + namespace + '/') if namespace else '/' }}rs_helios_5515</topic>
      <update_rate>{{ frequency }}</update_rate>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>{{ horizontal_samples }}</samples>
            <resolution>1</resolution>
            <min_angle>{{ -h_half }}</min_angle>
            <max_angle>{{ h_half }}</max_angle>
          </horizontal>
          <vertical>
            <samples>{{ channels }}</samples>
            <resolution>1</resolution>
            <min_angle>{{ v_min_rad }}</min_angle>
            <max_angle>{{ v_max_rad }}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>{{ range_min }}</min>
          <max>{{ range_max }}</max>
          <resolution>0.01</resolution>
        </range>
{%- if noise_enabled %}
        <noise>
          <type>gaussian</type>
          <mean>{{ noise_mean | default(0.0) }}</mean>
          <stddev>{{ noise_stddev | default(0.02) }}</stddev>
        </noise>
{%- endif %}
      </lidar>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
{%- endif %}
